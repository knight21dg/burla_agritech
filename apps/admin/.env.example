# ---------------------------------------------------------------------------
# Burla Admin — environment template
#
# Copy to .env.local and fill in. NEVER commit a file containing real values.
# NAMES ONLY here. No secret, key, password or connection string, in any
# branch, ever.
#
# The admin is deployed separately from the customer site, so it has its own
# environment. The database it points at is the same one — there is one source
# of truth, not an admin copy (docs/DATA-OWNERSHIP.md §1).
#
# Full descriptions: docs/ENVIRONMENT.md
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=
APP_ENV=

# --- Database --------------------------------------------------------------
# The same database as the customer site. Pooled for the application.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Authentication --------------------------------------------------------
AUTH_SECRET=
AUTH_URL=

# Salt for hashing IP addresses in the audit log. Raw IPs are never stored.
IP_HASH_SALT=

# --- Object storage (Cloudflare R2) ----------------------------------------
# Product photographs are uploaded here, and only from this application.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Rate limiting (Upstash Redis) -----------------------------------------
# Required in production: the in-memory limiter holds for one instance only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Monitoring ------------------------------------------------------------
SENTRY_DSN=

# --- Cache revalidation ----------------------------------------------------
# Shared secret, 32+ characters, the SAME value in both applications: the
# admin uses it to tell the storefront that a product has changed, because the
# two are separate deployments with separate caches.
# Generate with: openssl rand -base64 32
REVALIDATE_SECRET=
# The storefront's base URL, which the admin sends that message to.
STOREFRONT_URL=
