# ---------------------------------------------------------------------------
# Burla Global Agri Products — environment template
#
# Copy to .env.local and fill in. NEVER commit a file containing real values.
# This file lists NAMES ONLY. No secret, key, password or connection string
# belongs in this file, in any branch, ever.
#
# Docs: docs/ENVIRONMENT.md
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# development | test | production
NODE_ENV=
# Guards destructive scripts and disables demo data. Must be set explicitly
# in production; a missing value is treated as "not production".
APP_ENV=

# --- Public (exposed to the browser — never put a secret behind this prefix)
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Database --------------------------------------------------------------
# Pooled connection, used by the application.
DATABASE_URL=
# Direct (non-pooled) connection, used by migrations only.
DATABASE_URL_UNPOOLED=

# --- Authentication --------------------------------------------------------
# 32+ random bytes, base64. Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=

# --- Email (Resend) --------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
# Where customer enquiries are delivered.
ENQUIRY_NOTIFY_TO=

# --- Object storage (Cloudflare R2) ----------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public CDN base for stored objects.
R2_PUBLIC_BASE_URL=

# --- Rate limiting (Upstash Redis) -----------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Bot protection (Cloudflare Turnstile) ---------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Payments (Razorpay) — only if online selling is enabled (OQ-001) ------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Monitoring ------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Analytics -------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
