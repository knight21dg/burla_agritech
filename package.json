{
  "name": "burla",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@burla/web",
    "build": "npm run build --workspace=@burla/web",
    "start": "npm run start --workspace=@burla/web",
    "lint": "npm run lint --workspace=@burla/web",
    "typecheck": "npm run typecheck --workspace=@burla/web",
    "db:generate": "npm run db:generate --workspace=@burla/web",
    "db:migrate": "npm run db:migrate --workspace=@burla/web",
    "db:check": "npm run db:check --workspace=@burla/web"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
